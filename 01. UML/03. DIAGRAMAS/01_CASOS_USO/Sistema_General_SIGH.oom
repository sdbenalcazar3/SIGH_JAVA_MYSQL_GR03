<o:Shortcut Id="o379">
<a:ObjectID>F31F6BEE-16AA-4A84-B7BB-FE2E742CD178</a:ObjectID>
<a:Name>Farmacéutico</a:Name>
<a:Code>ACT-006</a:Code>
<a:CreationDate>1793716963</a:CreationDate>
<a:Creator>DANIEL</a:Creator>
<a:ModificationDate>1793716963</a:ModificationDate>
<a:Modifier>DANIEL</a:Modifier>
<a:TargetStereotype/>
<a:TargetID>31962803-EDEE-43D4-BD48-3C918E1D6545</a:TargetID>
<a:TargetClassID>18112101-1A4B-11D1-83D9-444553540000</a:TargetClassID>
