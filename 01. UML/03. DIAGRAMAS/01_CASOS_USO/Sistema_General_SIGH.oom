<c:Actors>
<o:Shortcut Id="o480">
<a:ObjectID>F1B0A82E-BBDB-4AE3-BF58-652278C82FE2</a:ObjectID>
<a:Name>Personal de facturación</a:Name>
<a:Code>ACT-007</a:Code>
<a:CreationDate>1793716964</a:CreationDate>
<a:Creator>DANIEL</a:Creator>
<a:ModificationDate>1793716964</a:ModificationDate>
<a:Modifier>DANIEL</a:Modifier>
<a:TargetStereotype/>
<a:TargetID>7819AA3C-1E06-48CB-8E0F-6B0C11966B12</a:TargetID>
<a:TargetClassID>18112101-1A4B-11D1-83D9-444553540000</a:TargetClassID>
