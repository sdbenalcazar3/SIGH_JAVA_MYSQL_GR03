<?PowerDesigner AppLocale="UTF16" ID="{2D82FA20-6C2C-46AA-8BB6-86996D072E93}" Label="SIGH - ERS corregido y ECUD 2.1" LastModificationDate="1793733430" Name="DS_GESTIONAR_ÓRDENES_Y_RESULTADOS_DE_LABORATORIO" Objects="273" Symbols="124" Target="Analysis" TargetLink="Reference" Type="{18112060-1A4B-11D1-83D9-444553540000}" signature="CLD_OBJECT_MODEL" version="16.5.0.3982"?>
<Model xmlns:o="object" xmlns:a="attribute" xmlns:c="collection">
  <o:RootObject Id="o1">
    <a:CreationDate>1793733430</a:CreationDate>
